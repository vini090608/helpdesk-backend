generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum BusinessHour {
  H08
  H09 
  H10
  H11
  H12
  H13
  H14
  H15
  H16
  H17
  H18
  H19
  H20
  H21
  H22
}

enum CallStatus {
  open
  processing
  ended
}

enum ServiceStatus {
  active
  inative
}

enum Role {
  client
  admin
  technical
}

model User{
  id Int @id @default(autoincrement())
  name String
  email String @unique
  password String
  profile String?

  role Role @default(client)
  hour BusinessHour[]

  calls Call[]

  @@map("users")
}

model Service{
  name String @unique
  amount Float
  status ServiceStatus? @default(inative)

  calls Call[]

  @@map("services")
}

model Call {
  id          Int        @id @default(autoincrement())
  title       String
  describe    String
  status      CallStatus @default(open)

  serviceAmount Float

  clientId    Int      @map("client_id")
  serviceName String   @map("service_name")

  user      User      @relation(fields: [clientId], references: [id])
  service   Service   @relation(fields: [serviceName], references: [name])

  updatdAt  DateTime? @updatedAt() @map("updated_at")

  @@map("calls")
}