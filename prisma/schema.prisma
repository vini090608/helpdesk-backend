generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum BusinessHour {
  H08
  H09 
  H10
  H11
  H12
  H13
  H14
  H15
  H16
  H17
  H18
  H19
  H20
  H21
  H22
}

enum CallStatus {
  open
  processing
  ended
}

enum ServiceStatus {
  active
  inactive
}

enum Role {
  client
  admin
  technical
}

model User{
  id Int @id @default(autoincrement())
  name String
  email String @unique
  password String
  profile String?

  role Role @default(client)
  hour BusinessHour[]

  clientCall Call[] @relation("client")
  technicalCall Call[] @relation("technical")

  @@map("users")
}

model Service{
  name String @unique
  amount Float
  status ServiceStatus? @default(active)

  serviceNameCall Call[] @relation("serviceName")

  @@map("services")
}

model Call {
  id          Int        @id @default(autoincrement())
  title       String
  describe    String
  status      CallStatus? @default(open)
  services String[]
  amount Float?

  serviceAmount Float @map("service_amount")

  clientId    Int      @map("client_id")
  TechnicalId Int?     @map("technical_id")
  serviceName String   @map("service_name")

  client      User      @relation("client" ,fields: [clientId], references: [id])
  technical      User?      @relation( "technical",fields: [TechnicalId], references: [id])
  serviceNameCall   Service   @relation("serviceName", fields: [serviceName], references: [name])

  updatedAt  DateTime? @updatedAt() @map("updated_at")
  createdAt  DateTime? @default(now()) @map("created_at")

  @@map("calls")
}